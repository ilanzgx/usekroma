# ==============================================================================
# KROMA - SELF-HOSTED CONFIGURATION (.env)
# ==============================================================================

# Application Exposure & Ports
WEB_PORT=13000
API_PORT=18080
FRONTEND_URL=http://localhost:13000
NEXT_PUBLIC_API_URL=http://localhost:18080/v1
GOOGLE_CALLBACK_URL=http://localhost:18080/v1/auth/google/callback

# Security & Secrets (Change in production)
JWT_SECRET=therealslimshady
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# PostgreSQL Database
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_BIND_IP=127.0.0.1
DB_PORT=5432

# RabbitMQ Message Broker
RABBITMQ_USER=kroma
RABBITMQ_PASS=kroma
RABBITMQ_BIND_IP=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MGMT_BIND_IP=127.0.0.1
RABBITMQ_MGMT_PORT=15672

# MinIO / Object Storage S3
STORAGE_ACCESS_KEY=kromauser
STORAGE_SECRET_KEY=kromapassword
STORAGE_BUCKET=kroma-storage
MINIO_API_BIND_IP=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_BIND_IP=127.0.0.1
MINIO_CONSOLE_PORT=9001

# General Settings
LOG_LEVEL=info
