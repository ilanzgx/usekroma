{
  "name": "@kroma/api",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node --env-file=.env dist/server.js",
    "start:prod": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run --reporter=tree",
    "test:unit": "vitest run --project unit --reporter=tree",
    "test:integration": "vitest run --project integration --reporter=tree",
    "test:ui": "vitest --ui --reporter=tree",
    "test:watch": "vitest --watch --reporter=tree",
    "test:coverage": "vitest run --coverage"
  },
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/oauth2": "^8.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/session": "^11.1.3",
    "@fastify/swagger": "^9.9.0",
    "@scalar/fastify-api-reference": "^1.71.0",
    "close-with-grace": "^2.5.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^6.1.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "4.1.10",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
